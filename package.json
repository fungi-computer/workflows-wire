{
  "name": "@fungi.computer/workflows-wire",
  "version": "0.0.0",
  "private": false,
  "description": "Workflow run ids and generic graph wire contract shared by Hub and the Workflows App",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "node ../../tooling/repository/scripts/format-package-check.mjs",
    "lint:anti-slop": "node ../../tooling/repository/scripts/lint-package-anti-slop.mjs",
    "lint": "eslint src --max-warnings=0 && ../../node_modules/.bin/oxlint --config ../../oxlint.config.ts --deny-warnings src",
    "pack": "mkdir -p ../../.botanical/workflows-wire-pack && pnpm pack --pack-destination ../../.botanical/workflows-wire-pack",
    "stranger": "tsx ../../tooling/repository/src/artifacts/cli.ts --repo-root ../.. .",
    "smoke": "node test/stranger/runtime.mjs",
    "prepack": "node scripts/prepare-package.mjs",
    "docs": "node ../../apps/package-docs/scripts/build-sites.mjs --check workflows-wire"
  },
  "dependencies": {
    "@fungi.computer/braid": "workspace:*",
    "@fungi.computer/cairn": "workspace:*",
    "@fungi.computer/puffball": "workspace:*",
    "effect": "4.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": {
        "status": "not-applicable",
        "reason": "Workflows App method and frontend tests and Hub workflow unit tests exercise this shared wire contract"
      },
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/workflows-wire.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "directory": ".botanical/package",
    "linkDirectory": false
  }
}
