{
  "name": "@fungi.computer/workflows-wire",
  "version": "0.7.21",
  "author": "Levi <levi@technomancy.dev>",
  "private": false,
  "description": "Workflow run ids and generic graph wire contract shared by Hub and the Trellis App",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node test/stranger/runtime.mjs",
    "prepack": "node scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@fungi.computer/braid": "0.6.20",
    "@fungi.computer/cairn": "0.1.1",
    "@fungi.computer/puffball": "0.15.2",
    "effect": "4.0.2",
    "zod": "4.4.3",
    "@fungi.computer/agar": "0.29.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": {
        "status": "not-applicable",
        "reason": "Trellis App method and frontend tests and Hub workflow unit tests exercise this shared wire contract"
      },
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/workflows-wire.git"
  },
  "files": [
    "dist",
    "docs/api",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "directory": ".botanical/package",
    "linkDirectory": false
  }
}
